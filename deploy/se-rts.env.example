# space-engineers-rts backend configuration (survival instance).
# Copy to .env next to the repository root, or use it as a systemd
# EnvironmentFile. Every value here is read from the environment.

# --- required -------------------------------------------------------------
# 32+ random characters. Must match `token` in plugin.json.
RTS_TOKEN=REPLACE_WITH_A_LONG_RANDOM_TOKEN
# Your own Steam id(s). With this empty, nothing is owned and nothing moves.
RTS_OWNER_STEAM_IDS=REPLACE_WITH_YOUR_STEAM_ID

# --- mode -----------------------------------------------------------------
RTS_ENV=live
RTS_DEMO=1
RTS_DEMO_SURVIVAL=1
# The executor needs demo_execute on a live instance.
RTS_FLAGS=demo_execute

# --- network --------------------------------------------------------------
# 0.0.0.0 for LAN access; 127.0.0.1 if you front it with a local proxy.
RTS_BIND=0.0.0.0
RTS_PORT=8761

# --- paths ----------------------------------------------------------------
RTS_DATA_DIR=./data
# RTS_DB_PATH=./data/rts.db
# Optional read-only copy of the world save for the handoff detector.
# RTS_SAVE_DIR=./data/save
# RTS_SBS_PATH=./data/save/SANDBOX_0_0_0_.sbs
# RTS_SBC_PATH=./data/save/Sandbox.sbc

# --- limits ---------------------------------------------------------------
RTS_SIMSPEED_MIN=0.95
RTS_DEMO_SPEED_MPS=100
RTS_MAX_ORDERS_PER_MIN=60
RTS_MAX_QUEUED_BUILDS=8
# Mission types allowed to skip approval. Empty = nothing skips approval.
# RTS_AUTO_MISSION_TYPES=
