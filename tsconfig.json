{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@se-rts/schemas": ["packages/schemas/src/index.ts"],
      "@se-rts/backend": ["packages/backend/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/scripts/**/*.ts",
    "packages/*/tests/**/*.ts",
    "scenarios/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["packages/demo-site"]
}
